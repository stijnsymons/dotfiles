[user]
	name = Stijn Symons
	email = stijn@novemberfive.co
[credential]
	helper = osxkeychain
[color]
	ui = auto
[core]
	excludesfile = /Users/stijn/.gitignore
	autocrlf = input
[alias]
	ahead = log @{upstream}..HEAD --oneline
    ls = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate
    unstage = reset HEAD --
[push]
	default = simple
[diff]
	tool = vimdiff
[merge]
	tool = vimdiff
[difftool]
	prompt = false
[init]
    defaultBranch = main
[pull]
    rebase = true
[fetch]
    prune = true
[rerere]
    enabled = true

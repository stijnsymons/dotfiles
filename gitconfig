[user]
	name = Stijn Symons
	email = ssymons@gmail.com
[credential]
	helper = osxkeychain
[color]
	ui = auto
[core]
	excludesfile = /Users/stijn/.gitignore
	autocrlf = input
[alias]
	ahead = log @{upstream}..HEAD --oneline
    ls = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]\\ %C(green)(%cr)" --decorate
    unstage = reset HEAD --
[push]
	default = simple
[diff]
	external = difft
	algorithm = histogram
[merge]
    tool = zed
[mergetool "zed"]
    cmd = zed --wait $MERGED
[difftool]
	prompt = false
[log]
	date = relative
[init]
    defaultBranch = main
[pull]
    rebase = true
[fetch]
    prune = true
[rerere]
    enabled = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[http]
	sslCAInfo = /Library/Application Support/AikidoSecurity/EndpointProtection/run/endpoint-protection-openssl-combined-ca.pem

[user]
	name = stijn
	email = stijn@novemberfive.co
[color]
	ui = auto
[core]
	excludesfile = /Users/stijn/.gitignore
	autocrlf = input
[alias]
	fancylog = log --decorate --graph --oneline
	ahead = log origin/master..HEAD --oneline
    ls = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate
[push]
	default = simple
[diff]
	tool = vimdiff
[merge]
	tool = vimdiff
[difftool]
	prompt = false

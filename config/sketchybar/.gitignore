# Compiled Swift helpers: sources are tracked, binaries are built on startup
# by bin/build.sh. Ignore everything in bin/ except the sources and scripts,
# so a new helper cannot slip in as a committed binary.
bin/*
!bin/*.swift
!bin/*.sh
!bin/*.c
!bin/*.h

# Vendored app-menu helper. `bin/*` above would swallow the whole directory
# and git never descends into an excluded one, so the dir is re-included and
# then its contents re-excluded, leaving only the sources tracked. The built
# SketchyBarAppleMenu.app stays out of the tree like every other artefact.
!bin/app-menu/
bin/app-menu/*
!bin/app-menu/*.swift
!bin/app-menu/Info.plist
!bin/app-menu/LICENSE
!bin/app-menu/ORIGIN.md

# Local backups from the Kanagawa -> Tokyo Night switch
*.bak

#!/usr/bin/env bash
# Tokyo Night Storm, plain bar (no islands/pills).
# Docs: https://felixkratz.github.io/SketchyBar/config/bar

PLUGIN_DIR="$CONFIG_DIR/plugins"
source "$CONFIG_DIR/colors.sh"

##### Display metrics #####
# Queried instead of hardcoded so the bar fits any Mac. BAR_HEIGHT is the
# reserved top inset - i.e. the MENU BAR's height, whatever macOS says it is
# today. Measured on this Mac: 30 on the DELL, 32 on the notched built-in. Do
# not re-hardcode these; earlier comments here said 38/24 and both have since
# drifted. NOTCH_L/NOTCH_R bound the region
# where items are invisible behind the notch (0 0 when there is no notch).
# Compile bin/*.swift if missing or stale (no-op once built).
"$CONFIG_DIR/bin/build.sh"

##### Helper #####
# bin/sb-helper renders mic, volume and the herdr cluster from one long-lived
# process, and samples the network interface to publish throughput into
# helper-state.json for the wifi card: sketchybar forks a script per item per
# tick, and the fork was the cost - those items burned ~4.2s of process
# time a minute between them, against ~0.004ms per update over the bar's own
# mach port. It also owns the stuck-card watchdog that each of those ticks used
# to drive, and it turns mic and volume from polls into CoreAudio listeners.
#
# The bootstrap name is how the volume item routes its events back: an item
# with mach_helper=<name> has its events delivered to that port instead of
# forking a script, which is what makes a scroll instant instead of a ~107ms
# wait on osascript. The helper sets that property on itself once it has
# actually claimed the name, so nothing here has to guess at the ordering.
# Started at the END of this file, once every item it paints exists.
SB_HELPER_NAME="git.felix.sbhelper"

read -r BAR_HEIGHT NOTCH_L NOTCH_R SCREEN_W <<<"$("$CONFIG_DIR/bin/screen-metrics" 2>/dev/null)"
: "${BAR_HEIGHT:=38}" "${NOTCH_L:=0}" "${NOTCH_R:=0}" "${SCREEN_W:=0}"
# :=38 does not catch a literal 0, which is what screen-metrics reports on an
# external primary with the menu bar auto-hidden - a zero-height, invisible bar
# on reload. Same guard as plugins/display.sh.
[ "$BAR_HEIGHT" -gt 0 ] 2>/dev/null || BAR_HEIGHT=38

##### Fonts and measured widths #####
# The width constants below were MEASURED against these exact font sizes (fixed
# widths stop the bar re-laying out as digit counts change). If you change a
# size, re-measure: set the label to its widest value with label.width=-1, read
# the item width, and use the difference. check.sh asserts no clipping.
FONT_ICON="Hack Nerd Font"
FONT_TEXT="FiraMono Nerd Font"
SZ_ICON=15.0  # default icon glyphs
SZ_LABEL=12.0 # default labels
W_PCT=35      # widest "100%"  at SZ_LABEL
# SZ_NET, W_SYS, W_NET, SYS_ROW and NET_ROW lived here and are gone with the
# items they measured. They described the two stacked two-row columns - cpu over
# mem, net_up over net_down - which used a negative padding_right to pull the
# lower row on top of the upper one. cpu/mem is deleted and the throughput moved
# into the wifi card, so nothing on the bar stacks any more. Bring the whole
# apparatus back together if a two-row item ever returns; half of it is useless.
# meeting and productive deliberately have NO width constant: plugins/fit.sh
# sizes them to content and ellipsises against the notch every tick. A fixed
# width there cannot grow into free space, and an undefined one silently
# renders as a bare icon.
W_MEDIA=200 # now-playing window: fixed, truncated, not scrolling.
# 154 -> 200 (+30%). 35 chars x 5.70pt at FiraMono/SZ_LABEL.
# check.sh asserts the cluster still clears the notch.

##### Bar #####
# Solid full-width bar flush to the top edge. No y_offset/margin = no floating.
#
# topmost is ON. macOS only reserves a top inset on a screen that shows the
# menu bar; with "Displays have separate Spaces" off (com.apple.spaces
# spans-displays = 1) that is the built-in one only - and there it is the NOTCH
# reserving it, not the menu bar, which auto-hides. So an external screen
# reserves nothing at all, and with topmost=off a maximised window there covers
# the bar entirely.
#
# topmost=on was tried for that once before and reverted for two reasons, and
# BOTH still apply - the omniwm outer gap below only softens the first one.
#
# One: windows that extend UNDER the bar have their top strip buried, because
# the bar now wins the z-order instead of losing it. The gap (top = 47) fixes
# this for windows omniwm TILES - measured, they land at y=59 (47 outer + 12
# inner) and clear the bar completely. It does NOT fix anything that sets the
# raw screen frame itself and so escapes omniwm's geometry: Raycast's Maximize
# does exactly that, snapping to 0,0 2560x1440 on the DELL - past both the
# 30pt macOS reserves in visibleFrame and omniwm's 47. Its top 30pt is then
# behind the bar. Use omniwm's own toggleFullscreen (Option+F, and
# fullscreenUsesOuterGaps=true) instead, which honours the gap.
#
# Two: topmost=on also draws above the auto-revealed menu bar, so on the
# external screen the real menu sits behind the bar when it slides down.
#
# topmost=off is the one-word revert. It costs the reverse: every maximised
# window covers the bar entirely rather than the bar covering part of it.
#
# topmost=window is documented as a middle setting ("on top of all windows"
# rather than of everything) which would have kept the bar over fullscreen
# windows while leaving the menu bar reachable. It does not exist in practice:
# sketchybar v2.24.0 reads `topmost=window` back as `on`. Verified by setting
# it and re-querying after a reload. So there are only two states here.
#
# show_in_fullscreen=on puts the bar on fullscreen SPACES; whether it then
# draws above the fullscreen window still depends on topmost.
#
# THE REAL FIX IS APPLIED, AND IT IS NOT IN THIS REPO. macOS will not reserve
# space for a third-party bar, so the window manager has to. omniwm does it via
#
#   [gaps.outer]
#   top = 47.0        # ~/.config/omniwm/settings.toml
#
# which is the one setting standing between this bar and being invisible behind
# every tiled window on an external display. Measured when it was 38: tiled
# windows on the DELL ended at y+h = 1654 of 1692, i.e. exactly 38pt clear. It
# has since been raised to 47, so the clearance is now larger than the bar
# rather than flush to it; check.sh asserts >=, not ==, so that passes.
#
# Why it matters on the external and not the built-in: macOS reserves a top
# inset only where it draws the menu bar, and on the built-in it is the NOTCH
# doing the reserving (frame 1117 vs visibleFrame 1085). An external screen
# reserves nothing at all - visibleFrame equals frame - so without this gap
# windows tile from y=0 and swallow the bar whole.
#
# It is GLOBAL rather than per-monitor, which costs ~32pt of the built-in when
# undocked: the notch already reserves 32 there, and this adds 47 on top. The
# per-monitor form is `monitorGapOverrides`, and four plausible TOML shapes for
# it (monitorName / displayName / name keys, outerGapTop / top values) were all
# parsed without complaint and all silently ignored, so the schema is not
# guessable from outside. Set it through omniwm's own Settings UI if the built-in
# space matters; check.sh asserts only that SOME top gap >= the bar height
# exists, so a per-monitor fix will not trip it.
#
# Note SketchyBar's own docs require "Displays have separate Spaces" ON, which
# this machine has OFF.
#
# display=main draws the bar on the PRIMARY display only - the one macOS gives
# the menu bar to. Make the external screen primary (System Settings ->
# Displays -> Arrange, drag the white menu bar strip onto it) and the bar
# follows it there, while the MacBook gets neither a menu bar nor a bar.
# Undock and primary reverts to the built-in, so the bar comes back on its own.
# No display index to maintain: "main" tracks whatever macOS considers primary.
sketchybar --bar height="$BAR_HEIGHT" \
  display=main \
  position=top \
  y_offset=0 \
  margin=0 \
  corner_radius=0 \
  border_width=0 \
  color="$BAR_COLOR" \
  blur_radius=0 \
  shadow=off \
  sticky=on \
  show_in_fullscreen=on \
  topmost=on \
  padding_left=8 \
  padding_right=8

##### Item defaults #####
default=(
  icon.font="$FONT_ICON:Bold:$SZ_ICON"
  label.font="$FONT_TEXT:Regular:$SZ_LABEL"
  icon.color="$FG"
  label.color="$FG"
  icon.padding_left=6
  icon.padding_right=6
  label.padding_left=0
  label.padding_right=6
  padding_left=0
  padding_right=0
  background.drawing=off
)
sketchybar --default "${default[@]}"

# Thin vertical rule between groups, replaces the old island gaps.
separator=(
  icon="│"
  icon.font="$FONT_TEXT:Regular:13.0"
  icon.color="$SEPARATOR"
  icon.padding_left=4
  icon.padding_right=4
  label.drawing=off
  background.drawing=off
  click_script=""
)

##### Hover cards #####
# plugins/card.sh owns the dwell delay, cancellation and the stuck-card
# watchdog; cards/<item>.sh supplies the rows. Rows are pre-created and hidden
# because building them on hover flashes an empty card while sketchybar lays
# them out. Eight each by default; card_rows_max in colors.sh raises the cards
# whose tail is a list rather than a fixed set of details.
card_popup=(
  popup.background.color="$POPUP_BG"
  popup.background.corner_radius=6
  popup.background.border_width=1
  popup.background.border_color="$SEPARATOR"
  popup.background.shadow.drawing=on
  popup.horizontal=off
  popup.height=24
  popup.align=left
  popup.y_offset=-4
)

# The same card, with NO popup.align at all - sketchybar places it rather than
# anchoring it to an edge of the item. For a card whose width is fixed and known
# an explicit align is better, which is why it stays the default above; but a
# card that changes width with its content can outgrow whichever edge it was
# pinned to, and then the anchor is the thing pushing it off screen. Only the
# herdr card needs this today. Built by filtering the array rather than being
# written out a second time, so a change to the border or the row height above
# cannot apply to eight cards and miss the ninth.
card_popup_noalign=()
for _p in "${card_popup[@]}"; do
  case "$_p" in popup.align=*) ;; *) card_popup_noalign+=("$_p") ;; esac
done
unset _p

# One sketchybar call per card, not one per row. Every invocation is a ~8ms
# round trip to the running bar, and cold start was issuing ~90 of them before
# the first paint; batching the loops here is most of that back.
card_rows_for() { # card_rows_for <item>
  local i=1
  local args=()
  local max
  max="$(card_rows_max "$1")"
  while [ "$i" -le "$max" ]; do
    args+=(--add item "$1.pop.$i" "popup.$1"
      --set "$1.pop.$i" drawing=off
      label.align=left
      label.font="$FONT_TEXT:Regular:12.0"
      icon.padding_left=12
      icon.padding_right=10
      label.padding_left=0
      label.padding_right=14
      background.drawing=off
      click_script="$PLUGIN_DIR/card.sh $1 close")
    i=$((i + 1))
  done
  sketchybar "${args[@]}"
}

##### Left: workspaces | focused app #####
# Five pips for the five workspaces alt-1..alt-5 reach, so "which workspace"
# then "which app" reads left to right in one glance.
#
# The pips are fixed-width - all four are always drawn, occupancy is carried in
# the colour - which makes them a stable anchor for everything to their right:
# nothing shuffles sideways as workspaces fill and empty. front_app behind them
# still varies, and meeting and productive already fit themselves against that
# every tick.
#
# Digits rather than dots or app icons: the digit IS the keystroke, so the pip
# is a legend for alt-1..alt-5 as much as it is a state readout. Icon-only and
# tight padding keeps the whole cluster to 114pt with its rule - 21pt per pip,
# so a further workspace is affordable: the left cluster ends at 474 against a
# notch starting at 918 on the built-in display, and fit.sh takes any shortfall
# out of the meeting label rather than overrunning.
#
# No script and no update_freq on the pips themselves - space_watch below owns
# the paint for all of them. background is configured here but left off; the
# plugin only ever flips drawing, so the pill's geometry cannot drift between
# the items.
spaces_args=()
for sid in $SPACE_IDS; do
  spaces_args+=(--add item "space.$sid" left
    --set "space.$sid" icon="$sid"
    icon.font="$FONT_TEXT:Bold:$SZ_LABEL"
    icon.color="$FG_DIM"
    icon.padding_left=6
    icon.padding_right=6
    label.drawing=off
    padding_left=1
    padding_right=1
    background.color="$SEPARATOR"
    background.corner_radius=4
    background.height=20
    background.drawing=off
    click_script="$PLUGIN_DIR/workspaces.sh focus $sid")
done
sketchybar "${spaces_args[@]}"

# omniwm has no config-level callback for a workspace switch - it exposes an IPC
# stream instead - so the watcher started at the end of this file translates that
# stream into this trigger. Declared here because a custom event has to exist
# before anything can subscribe to it.
sketchybar --add event wm_workspace_change

# Zero-width item that paints every pip, same shape as display_watch and
# card_watch on the right. space_windows_change is what keeps the occupied /
# empty shading honest - it fires whenever any app anywhere opens or closes a
# window, which is exactly the question being asked here (it is excluded from
# $CARD_AWAY_EVENTS for the opposite reason: it is not a click).
# front_app_switched and system_woke are the cheap catch-ups for anything that
# moved a window without either event landing.
sketchybar --add item space_watch left \
  --set space_watch drawing=off \
  icon.drawing=off \
  label.drawing=off \
  script="$PLUGIN_DIR/workspaces.sh" \
  --subscribe space_watch wm_workspace_change \
  space_windows_change \
  front_app_switched \
  system_woke

# Rule between the workspace cluster and the focused app. workspaces.sh
# hides it alongside the pips when the window manager is not up, so a hidden
# cluster never leaves a rule dangling against the bar's left edge.
sketchybar --add item sep.spaces left --set sep.spaces "${separator[@]}"

# Clicking it drops the focused app's own menu bar under the pointer, via
# omniwm's open-menu-anywhere - the menus the real menu bar would show if it
# were not auto-hidden behind the notch. The item that names the app is the
# obvious place to hang them; this briefly lived on a dedicated  item, which
# promised an Apple menu and delivered these instead.
#
# icon.color is load-bearing beyond the theme: app_menu.sh repaints it red when
# the menu surface is unreachable and back to this colour when a click works, so
# the two have to agree on $PINK. front_app.sh sets icon and label on a switch
# but never the colour, which is what lets a red survive until the next good
# click instead of being wiped by the next app switch.
sketchybar --add item front_app left \
  --set front_app icon.color="$PINK" \
  label.max_chars=25 \
  label.font="$FONT_TEXT:Regular:13.0" \
  script="$PLUGIN_DIR/front_app.sh" \
  click_script="$PLUGIN_DIR/app_menu.sh" \
  --subscribe front_app front_app_switched

# herdr_flock has to be declared here, ABOVE its subscribers: meeting and
# productive both subscribe to it, and a custom event must exist before anything
# can subscribe. The herdr cluster that fires it now lives on the right side of
# the bar, next to media - see "Right: herdr flock" further down - but the event
# declaration cannot follow it without breaking those two subscriptions.
sketchybar --add event herdr_flock

sketchybar --add item sep.now left --set sep.now "${separator[@]}"

# Current meeting (hides itself when nothing is running).
#
# Left cluster on purpose: this and `productive` are the two wide text items,
# and the right cluster clears the notch by only ~26pt at 1512x982 (see README).
# Putting them right would fail that clearance exactly when a meeting is on
# screen -- i.e. never during a check run, only mid-call.
#
# The only item that touches the network, hence update_freq=60 and not less.
# meeting.sh caches the event JSON, so meeting_click.sh joins the call without a
# second API round-trip. system_woke refreshes on lid-open rather than leaving
# up to a minute of stale "N min left" on screen.
sketchybar --add item meeting left \
  --set meeting drawing=off \
  icon.color="$GREEN" \
  label.color="$FG" \
  label.font="$FONT_TEXT:Regular:13.0" \
  update_freq=60 \
  click_script="$PLUGIN_DIR/card.sh meeting toggle" \
  script="$PLUGIN_DIR/meeting.sh" \
  --set meeting "${card_popup[@]}" \
  --subscribe meeting system_woke herdr_flock mouse.exited.global

# Divider between the two "right now" items. meeting.sh hides this alongside
# itself on the failed-fetch path, so a hidden meeting never leaves a rule
# dangling against the front_app separator.
sketchybar --add item sep.timing left --set sep.timing "${separator[@]}"

# Productive.io timer. Red when nothing is being timed -- that is the whole
# point of the item, so it must never be mistaken for a quiet success state.
# Also network-bound: update_freq=60, cached, click always opens the timesheet.
sketchybar --add item productive left \
  --set productive update_freq=60 \
  label.color="$FG" \
  label.font="$FONT_TEXT:Regular:13.0" \
  script="$PLUGIN_DIR/productive.sh" \
  click_script="$PLUGIN_DIR/card.sh productive toggle" \
  --subscribe productive system_woke herdr_flock

sketchybar --set productive "${card_popup[@]}" \
  --subscribe productive mouse.exited.global

##### Right side, added right-to-left #####

# Clock (rightmost). padding_right keeps the last digit clear of the macOS
# recording indicator, which macOS paints over the corner of the screen.
#
# The click used to open Calendar.app, which the user does not use at all --
# their calendar is a pinned Brave tab. It opens the card instead, which
# carries the ISO week (the one date fact macOS never shows), this week's
# hours, and rows that go to the places the click was reaching for.
sketchybar --add item clock right \
  --set clock icon=󰥔 \
  icon.color="$VIOLET" \
  padding_right=10 \
  update_freq=15 \
  click_script="$PLUGIN_DIR/card.sh clock toggle" \
  script="$PLUGIN_DIR/clock.sh"

# popup.align=right overrides card_popup's left: clock is the RIGHTMOST item, so
# a left-aligned popup grows off the screen. Measured at 1728pt wide - the widest
# row ran to x=1800, losing 72pt of "13h / 34h logged this week" past the edge.
# Aligning right anchors the popup's right edge to the item's and it grows
# inwards (1473..1709, clear).
#
# "Far enough left" was the wrong test and this comment used to clear wifi and
# herdr with it. The items to an item's RIGHT are what set its budget, and those
# are right-anchored, so the room a popup has is fixed by the item's neighbours
# and does not grow with the display. wifi sits at x=1757 with 299pt to the edge
# on a 2056pt screen - and had the same 299pt on the 1728pt screen this was first
# measured on - against a 366pt card. It was clipped by 67pt the whole time, in
# the same way and for the same reason as the clock. See the wifi --set below.
# Measure with `sketchybar --query <item>.pop.1` for the width; the popup's own
# rect is not exposed.
sketchybar --set clock "${card_popup[@]}" popup.align=right \
  --subscribe clock mouse.exited.global

sketchybar --add item sep.clock right --set sep.clock "${separator[@]}"

# Mic in use (hidden unless something is capturing). No update_freq and no
# script: bin/sb-helper renders this from a CoreAudio listener, so the state
# arrives when it changes instead of being polled every 3s.
#
# The click opens a card listing WHICH applications are capturing - the glyph
# alone answers the less useful half of the question. The privacy pane the
# click used to open is the card's last row, so nothing was lost.
sketchybar --add item mic right \
  --set mic drawing=off \
  click_script="$PLUGIN_DIR/card.sh mic toggle"

# align=right for the same reason as the clock: mic sits in the right cluster,
# and app names are long enough that a left-aligned card can leave the screen.
sketchybar --set mic "${card_popup[@]}" popup.align=right \
  --subscribe mic mouse.exited.global

sketchybar --add item sep.status right --set sep.status "${separator[@]}"

##### Right group 3: volume | wifi | caffeine | battery #####
# The machine's own state, as opposed to the two groups left of it: herdr/claude/
# github are work that is happening, this is the laptop it is happening on.
#
# CREATED IN REVERSE of how it reads. The right cluster fills right-to-left, so
# the first item added lands furthest right - battery here, volume last. Every
# group below follows the same rule, which is why they look backwards in the
# file and correct on screen.
sketchybar --add item battery right \
  --set battery label.width="$W_PCT" \
  label.align=left \
  update_freq=120 \
  click_script="open 'x-apple.systempreferences:com.apple.Battery-Settings.extension'" \
  script="$PLUGIN_DIR/battery.sh" \
  --subscribe battery system_woke power_source_change

# Keep-awake toggle. Green mug = our own `caffeinate -i` is holding the machine
# awake, dim = off. update_freq re-validates the PID, so a caffeinate killed
# from outside (or a recycled PID) goes gray on its own within 30s.
#
# The click toggles directly rather than opening a card. A two-state switch
# behind a popup meant two clicks and a read to do what the icon colour already
# tells you, so caffeine_click.sh is wired straight to the item. It renders to
# the literal `caffeine` item name (CAFFEINE_ITEM in caffeine.sh) rather than to
# $NAME, which is what lets the same script serve a direct click here and still
# work if it is ever put back behind a card row.
sketchybar --add item caffeine right \
  --set caffeine update_freq=30 \
  label.drawing=off \
  script="$PLUGIN_DIR/caffeine.sh" \
  click_script="$PLUGIN_DIR/caffeine_click.sh"

# wifi_change is what actually moves this item, and it fires the moment the
# association changes. The poll is only a backstop for a missed event, so it
# runs at 60 rather than 15 - each tick spawned networksetup + ipconfig for an
# SSID that had not changed.
#
# The throughput used to be two stacked bar items beside it, net_up over
# net_down. They are rows in the wifi card now: a number that changes every
# three seconds is something you look AT deliberately, not something worth a
# permanent column next to the clock - and the pair cost ~44pt of bar for digits
# that were mostly 0B. sb-helper still samples the interface at the same rate
# and publishes the rates into helper-state.json; cards/wifi.sh reads them when
# the card opens.
sketchybar --add item wifi right \
  --set wifi update_freq=60 \
  label.drawing=off \
  click_script="$PLUGIN_DIR/card.sh wifi toggle" \
  script="$PLUGIN_DIR/wifi.sh" \
  --subscribe wifi wifi_change

# popup.align=right for the same reason as the clock, measured the same way: the
# card is 366pt wide (wifi.pop.1 bounding_rect) and the item sits at x=1757, so a
# left-aligned popup ran to 2123 on a 2056pt screen and lost the last 67pt - the
# right-hand VALUE column, which is the half of every row worth reading. Anchored
# right it spans 1417..1783 and clears. The cost is the documented one: the card
# opens beside the item rather than under it, which is the correct trade when the
# alternative is losing the IP addresses off the edge.
sketchybar --set wifi "${card_popup[@]}" popup.align=right \
  --subscribe wifi mouse.exited.global

sketchybar --add item volume right \
  --set volume icon.color="$YELLOW" \
  label.width="$W_PCT" \
  label.align=left \
  --subscribe volume volume_change mouse.clicked mouse.scrolled

# Divides the work group (herdr / claude / github) from the machine group. Named
# sep.net from when it flanked the throughput items, which are gone; the name is
# left alone because renaming it would break any saved --query and buys nothing.
sketchybar --add item sep.net right --set sep.net "${separator[@]}"

# GitHub: orgs, recently-pushed repos, and PRs waiting on your review.
#
# The label is the count of review requests and is drawn ONLY when there are
# any - an idle widget is a bare glyph, so a number appearing is itself the
# signal. plugins/github.sh paints both, and colours the glyph by state: green
# when clean, yellow when something is waiting on you, red when it could not
# ask. That last one matters more than it looks - "no token", "token rejected",
# "TLS proxy in the way" and "genuinely nothing to review" all produce an empty
# list, and the card gives each its own sentence rather than letting a failure
# render as an absence.
#
# 600s: four API calls a tick is 24 requests an hour against a 5000/hour limit,
# and review requests do not arrive faster than you can act on them. The card
# reads the cache and never the network, so this interval costs nothing on the
# click path.
#
# It sits with herdr and claude, not with wifi and battery: all three are work
# in flight - agents running, quota burning, reviews waiting - as against the
# machine-state group to their right.
#
# The transport is `gh`, and it is currently BLOCKED on this machine. Aikido's
# endpoint agent MITMs TLS and publishes its root only into the per-runtime PEM
# bundles curl/node/python read; Go verifies through macOS Security.framework
# and never sees it, so every gh call dies with x509 OSStatus -26276 while curl
# on the same host succeeds. Until the root is trusted in the System keychain
# this item sits red and its card says so in as many words. Do not "fix" it by
# switching to curl - that was tried and deliberately reverted; see the
# transport note at the top of plugins/github.sh.
sketchybar --add item github right \
  --set github icon="$(printf '\357\202\233')" \
  icon.color="$FG_DIM" \
  icon.font="$FONT_ICON:Regular:14.0" \
  label.drawing=off \
  label.font="$FONT_TEXT:Bold:$SZ_LABEL" \
  label.padding_right=4 \
  update_freq=600 \
  script="$PLUGIN_DIR/github.sh" \
  click_script="$PLUGIN_DIR/card.sh github toggle"

sketchybar --set github "${card_popup[@]}" popup.align=right \
  --subscribe github mouse.exited.global

# Herdr flock: the agents the herdr session is running, one coloured digit per
# state (plugins/herdr.sh renders, cards/herdr.sh details, click toggles the
# card), plus the Claude weekly-usage figure.
#
# Created in REVERSE of the reading order. The right cluster fills right-to-left
# (see "added right-to-left" above), so the first item added is the rightmost -
# and the intended reading is `media | herdr  1 2 3 | claude`, which means the
# claude digit goes in first and sep.herdr last.
#
# It used to sit on the left between front_app and meeting, where its width
# pushed those two around and herdr_flock existed to make them re-fit. Over here
# it pushes nothing: meeting and productive are on the other side of the bar.
# The event still fires and they still listen, which is now a no-op on their
# geometry - harmless, and left in place because notch_guard in herdr.sh still
# measures their edges for the real notch collision.
herdr_args=()
# The Claude weekly figure. NOT painted by sb-helper, unlike the five state
# digits - it is a shell script reading transcript files, which is the wrong
# shape for the helper's tick loop. That means it needs its own update_freq:
# `herdr` itself deliberately has none (check.sh asserts "herdr has no poll
# timer"), so a field painted only alongside it would never refresh.
#
# It also does NOT hide with the flock. herdr.sh's hide path enumerates the five
# state items by name and leaves this one alone, which is the behaviour we want:
# weekly usage is worth seeing whether or not any agent happens to be running.
#
# Named `claude`, NOT `herdr.claude`, even though it sits inside that cluster.
# card.sh derives everything from the item name - it sources cards/$ITEM.sh,
# addresses $ITEM.pop.$N and stamps card-$ITEM.at - so a dotted name would send
# it looking for cards/herdr.claude.sh. The name is the card's identity, not a
# statement about which cluster the item is drawn next to.
herdr_args+=(--add item claude right
  --set claude icon="$(printf '\363\260\232\251')"
  icon.color="$VIOLET"
  icon.font="$FONT_ICON:Regular:12.0"
  icon.padding_left=6
  icon.padding_right=3
  label.font="$FONT_TEXT:Bold:$SZ_LABEL"
  label.padding_right=4
  update_freq=300
  script="$PLUGIN_DIR/claude_usage.sh"
  click_script="$PLUGIN_DIR/card.sh claude toggle")
for st in unknown idle 'done' working blocked; do
  herdr_args+=(--add item "herdr.$st" right
    --set "herdr.$st" drawing=off
    icon.drawing=off
    label.font="$FONT_TEXT:Bold:$SZ_LABEL"
    label.padding_left=2
    label.padding_right=3
    click_script="$PLUGIN_DIR/card.sh herdr toggle")
done
herdr_args+=(--add item herdr right
  --set herdr drawing=off
  icon="$(printf '\363\260\263\206')"
  icon.color="$FG_DIM"
  icon.padding_right=2
  label.drawing=off
  script="$PLUGIN_DIR/herdr.sh"
  click_script="$PLUGIN_DIR/card.sh herdr toggle"
  --add item sep.herdr right
  --set sep.herdr "${separator[@]}" drawing=off)
# popup.align is left unset here - not "left", UNSET - so sketchybar places the
# card itself rather than anchoring it to an edge of the item.
#
# Both explicit values were tried and both are wrong for this one. align=right
# anchors the popup's right edge to the item's and grows it leftward, which put
# the card BESIDE the widget instead of under it. align=left grows it rightward
# from the item, and this card is now the widest on the bar - 58 characters of
# fixed-pitch rows, up to 28 of them - so from the herdr cluster's x it runs
# straight off the right of the screen. Letting sketchybar choose is the only
# option that survives the card changing width with the size of the flock.
sketchybar "${herdr_args[@]}" --set herdr "${card_popup_noalign[@]}"

# The claude card. popup.align=right here, unlike herdr immediately above, and
# the difference is the popup's WIDTH rather than the item's position: the usage
# card runs to ~46 characters against herdr's short `<title> · <cwd>` rows, so
# anchored left from mid-cluster it reaches past wifi and battery toward the
# screen edge. Same reason the clock documents further up.
#
# No card_rows_for here: `claude` is in $CARD_ITEMS, and the loop near the end
# of this file creates one set of rows for every item in it. Calling it here as
# well would build all ten rows twice.
sketchybar --set claude "${card_popup[@]}" popup.align=right \
  --subscribe claude mouse.exited.global

# The visibility memory must not survive a reload: initial paint races the
# cluster into place, and a stale "on" would swallow the poke that repairs it.
rm -f "$SB_CACHE_DIR/herdr.visible" "$SB_CACHE_DIR/herdr.edge"
sketchybar --subscribe herdr system_woke mouse.exited.global

# Media (hides itself when nothing is playing)
#
# media_change catches a track flip instantly, so the poll only has to pick up
# elapsed-state drift: 15, not 5. nowplaying-cli costs ~115ms a call, which at
# 5s was ~2.3% of a core around the clock for a label that mostly did not move.
sketchybar --add item media right \
  --set media icon.color="$GREEN" \
  label.color="$FG" \
  label.max_chars=35 \
  label.width="$W_MEDIA" \
  label.align=left \
  scroll_texts=off \
  update_freq=15 \
  script="$PLUGIN_DIR/media.sh" \
  click_script="$PLUGIN_DIR/card.sh media toggle" \
  --subscribe media media_change

sketchybar --set media "${card_popup[@]}" \
  --subscribe media mouse.exited.global

##### Display watcher #####
# Zero-width item whose only job is to re-fit the bar height when the
# resolution changes; the startup probe above runs only at config load.
sketchybar --add item display_watch right \
  --set display_watch drawing=off \
  icon.drawing=off \
  label.drawing=off \
  script="$PLUGIN_DIR/display.sh" \
  --subscribe display_watch display_change

##### Outside-click watcher #####
# Zero-width item that stands in for the global click event sketchybar does not
# have. Cards already close when the pointer leaves the bar and when another
# card opens; neither covers clicking straight into another app or cmd-tabbing
# without moving the mouse. $CARD_AWAY_EVENTS is the set that does - see the
# note there, which also records why a real mouse monitor was rejected.
#
# One watcher rather than the same subscription on all seven owners: that is a
# single forked script per app switch instead of seven, and card.sh's away
# sweep closes every item in $CARD_ITEMS in one call regardless of which was
# open. Because the sweep reads that set itself, a new card is wired into the
# close path by naming it in colors.sh and nowhere else - nothing to add here.
#
# shellcheck disable=SC2086  # deliberate split: one --subscribe, every event
sketchybar --add item card_watch right \
  --set card_watch drawing=off \
  icon.drawing=off \
  label.drawing=off \
  script="$PLUGIN_DIR/card.sh away" \
  --subscribe card_watch $CARD_AWAY_EVENTS

# Card rows are added last: every parent item must exist first.
for c in $CARD_ITEMS; do card_rows_for "$c"; done

##### Helper start #####
# After every item exists, so the helper's opening paint lands on real items
# rather than being dropped and leaving "--" until its first timer.
#
# The old instance is killed first: a reload re-runs this file, and two helpers
# would both hold timers and fight over the same items - and the second would
# fail to claim the bootstrap name (kr=1101), silently losing the volume events.
#
# ps + kill, NOT pkill. This said `pkill -x sb-helper` and it was observed
# FAILING SILENTLY on this machine, leaving two helpers running for nearly two
# hours - pkill and pgrep both depend on sysmond, which has been seen refusing
# ("sysmond service not found: Cannot get process list") while ps kept working.
# The failure mode is invisible from here: pkill exits 0 having killed nothing,
# a second helper starts, and the loser of the bootstrap race stops delivering
# volume scroll events with no error anywhere. Same reasoning, and the same
# fix, as the omniwm watcher at the end of this file and as bin/wmswitch.sh.
#
# Matched on the process NAME rather than a path: this config is reached through
# ~/.config/sketchybar, a symlink, so the path a running helper reports is not
# the path this script would build. Anchored on / so a directory containing the
# word cannot match.
# Backgrounded and disowned - sketchybar waits on its config script, so a
# foreground helper would hang the reload forever.
if [ -x "$CONFIG_DIR/bin/sb-helper" ]; then
  for _h in $(ps -Ao pid=,comm= | awk '$0 ~ /\/sb-helper$/ {print $1}'); do
    kill "$_h" 2>/dev/null
  done
  unset _h
  "$CONFIG_DIR/bin/sb-helper" "$SB_HELPER_NAME" >/dev/null 2>&1 &
  disown
else
  # No helper (toolchain missing, or a compile that failed - see
  # ~/.cache/sketchybar/build-sb-helper.err). The items it owns would sit at
  # "--" forever, so fall back to the shell plugins by restoring their timers.
  printf 'sketchybar: bin/sb-helper missing, falling back to shell plugins\n' >&2
  # No net_down line any more: the throughput is a card row, and cards/wifi.sh
  # reads the helper's state file. Without the helper that row simply reports
  # nothing, which is the honest outcome - there is no shell sampler left on the
  # bar to restore a timer to.
  sketchybar --set mic update_freq=3 script="$PLUGIN_DIR/mic.sh" \
    --set volume script="$PLUGIN_DIR/volume.sh" \
    --set herdr update_freq=5 script="$PLUGIN_DIR/herdr.sh"
fi

##### omniwm event watcher #####
# omniwm has no config-level callback for a workspace switch - it exposes an IPC
# stream instead - so one long-lived `omniwmctl watch` translates that stream
# into the wm_workspace_change trigger the pip item is already subscribed to.
#
# Killed first for the same reason sb-helper is: a reload re-runs this file, and
# two watchers would both fire the trigger on every switch. Matched on ARGUMENTS,
# because the process name is just omniwmctl and only the argv identifies this
# particular watcher - and matched through ps rather than pkill, which depends on
# sysmond and has been seen failing on this machine with "sysmond service not
# found" while ps kept working. A silent failure here leaves watchers stacking up
# on every reload.
#
# --reconnect is what makes this survive an omniwm relaunch: the CLI retries the
# handshake with a 0.5s-to-5s backoff and re-requests initial snapshots, so the
# pips resynchronise instead of freezing on whatever was last painted. Placed
# BEFORE --exec deliberately - the docs are explicit that a flag after --exec
# belongs to the child command.
#
# windows-changed rides along with active-workspace so the occupied/empty
# shading keeps up with windows opening and closing, not just with switches. It
# is the precise version of the space_windows_change the item also subscribes
# to, which fires for any app anywhere.
#
# IPC is OFF by default in omniwm (Settings -> Enable IPC). Without it this
# watcher exits immediately, the trigger never fires, and workspaces.sh finds no
# focused workspace and hides the cluster - which is the honest outcome, but
# `omniwmctl ping` is the thing to check when the pips are missing.
for _w in $(ps -Ao pid=,args= | awk '/omniwmctl watch active-workspace/ && !/awk/ {print $1}'); do
  kill "$_w" 2>/dev/null
done
unset _w
if command -v omniwmctl >/dev/null 2>&1; then
  omniwmctl watch active-workspace,windows-changed --reconnect \
    --exec sketchybar --trigger wm_workspace_change >/dev/null 2>&1 &
  disown
else
  printf 'sketchybar: omniwmctl is not on PATH - the workspace pips will not repaint\n' >&2
fi

##### First paint #####
sketchybar --update

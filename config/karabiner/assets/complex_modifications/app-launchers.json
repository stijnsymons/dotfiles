{
  "title": "App launchers",
  "rules": [
    {
      "description": "App launchers: Option + t/b/o/s/m -> focus-or-open",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "t",
            "modifiers": { "mandatory": ["option"] }
          },
          "to": [
            {
              "shell_command": "/Users/stijn/.config/sketchybar/bin/focus-or-open.sh com.mitchellh.ghostty"
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "b",
            "modifiers": { "mandatory": ["option"] }
          },
          "to": [
            {
              "shell_command": "/Users/stijn/.config/sketchybar/bin/focus-or-open.sh com.brave.Browser"
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "o",
            "modifiers": { "mandatory": ["option"] }
          },
          "to": [
            {
              "shell_command": "/Users/stijn/.config/sketchybar/bin/focus-or-open.sh md.obsidian"
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "s",
            "modifiers": { "mandatory": ["option"] }
          },
          "to": [
            {
              "shell_command": "/Users/stijn/.config/sketchybar/bin/focus-or-open.sh com.tinyspeck.slackmacgap"
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "m",
            "modifiers": { "mandatory": ["option"] }
          },
          "to": [
            {
              "shell_command": "/Users/stijn/.config/sketchybar/bin/focus-or-open.sh com.spotify.client"
            }
          ]
        }
      ]
    }
  ]
}

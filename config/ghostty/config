# Enable copy on select - automatically copy selected text to clipboard
copy-on-select = clipboard
theme = Ayu Mirage
window-padding-x = 5
window-padding-y = 5
click-repeat-interval = 500
quit-after-last-window-closed = true
macos-option-as-alt = left
macos-titlebar-style = hidden
keybind = cmd+backspace=ignore

# Enable copy on select - automatically copy selected text to clipboard
copy-on-select = clipboard
# follows the macOS appearance; `theme` (./theme) overrides it, see the end
theme = light:Horizon Bright,dark:Aura
window-padding-x = 5
window-padding-y = 5
click-repeat-interval = 500
quit-after-last-window-closed = true
macos-option-as-alt = left
macos-titlebar-style = hidden
# brew manages updates; don't check or nag in-app
auto-update = off
keybind = cmd+backspace=ignore
font-family = "FiraMono Nerd Font Mono"
# Manual light/dark override written by ./theme (`theme` in zsh).
# Missing = follow macOS via the theme line at the top.
config-file = ?~/.local/state/theme.ghostty

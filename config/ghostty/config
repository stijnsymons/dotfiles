# Enable copy on select - automatically copy selected text to clipboard
copy-on-select = clipboard
# follows the macOS appearance automatically; no scripting needed
theme = light:Catppuccin Latte,dark:Catppuccin Macchiato
window-padding-x = 5
window-padding-y = 5
click-repeat-interval = 500
quit-after-last-window-closed = true
macos-option-as-alt = left
macos-titlebar-style = hidden
# brew manages updates; don't check or nag in-app
auto-update = off
keybind = cmd+backspace=ignore

// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "icon_theme": "Colored Zed Icons Theme Dark",
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left",
    "tree_view": true
  },
  "context_servers": {
    "mcp-server-github": {
      "enabled": true,
      "remote": false,
      "settings": {}
    }
  },
  "git": {
    "inline_blame": {
      "show_commit_summary": true
    }
  },
  "terminal": {
    "dock": "right",
    "toolbar": {
      "breadcrumbs": false
    },
    "cursor_shape": "bar",
    "font_family": "FiraMono Nerd Font Mono",
    "font_size": 14.0
  },
  "bottom_dock_layout": "contained",
  "tabs": {
    "file_icons": true,
    "git_status": false
  },
  "title_bar": {
    "show_branch_name": true
  },
  "search": {
    "regex": true
  },
  "prettier": {
    "allowed": false
  },
  "toolbar": {
    "agent_review": true,
    "selections_menu": true,
    "quick_actions": true,
    "breadcrumbs": true
  },
  "minimap": {
    "show": "auto"
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "show_wrap_guides": true,
  "agent_ui_font_size": 14.0,
  "buffer_font_family": ".ZedMono",
  "edit_predictions": {
    "mode": "eager"
  },
  "always_treat_brackets_as_autoclosed": true,
  "indent_guides": {
    "background_coloring": "indent_aware",
  },
  "colorize_brackets": false,
  "show_edit_predictions": false,
  "agent_servers": {
    "your_agent": {
      "type": "custom",
      "command": "path_to_executable",
      "args": [],
      "env": {},
    },
  },
  "debugger": {
    "dock": "right",
  },
  "agent": {
    "inline_assistant_model": {
      "provider": "anthropic",
      "model": "claude-haiku-4-5-latest",
      "enable_thinking": false
    },
    "dock": "right",
    "default_model": {
      "provider": "anthropic",
      "model": "claude-opus-4-6-latest"
    },
    "model_parameters": [],
  },
  "vim_mode": false,
  "ui_font_size": 16.0,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "Ayu Mirage",
  },
}
